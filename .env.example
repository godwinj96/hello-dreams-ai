# =============================================================================
# Hello Dreams AI — Backend environment template
# =============================================================================
# Copy to `.env` for local dev, or set these in your host (Render, Railway, etc.).
#
# Quick start:
#   cp .env.example .env
#   # Fill REQUIRED values, then:
#   npm run migration:run
#   npm run start:dev
#
# Paystack dashboard (do once per environment):
#   1. Create a monthly Pro plan → copy plan code → PAYSTACK_PLAN_CODE
#   2. Webhook URL: https://<API_HOST>/payments/webhook
#   3. Use TEST keys in staging, LIVE keys in production
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — app will not start without these
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Long random string (e.g. openssl rand -base64 48)
JWT_SECRET=change-me

# Postgres connection string (Supabase or Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/hello_dreams_ai

# Comma-separated frontend origins allowed by CORS (no trailing slash)
# Local: http://localhost:5173
# Staging: https://staging.hellodreams.ai
# Production: https://app.hellodreams.ai
CORS_ORIGIN=http://localhost:5173

# Public app URL — used for payment callback + OAuth redirect target
# Must match where the React app is hosted (no trailing slash)
FRONTEND_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# PAYMENTS — required to monetize (Paystack)
# -----------------------------------------------------------------------------

# Staging: sk_test_...  |  Production: sk_live_...
PAYSTACK_SECRET_KEY=

# Staging: pk_test_...  |  Production: pk_live_...
PAYSTACK_PUBLIC_KEY=

# From Paystack Dashboard → Plans → plan code (e.g. PLN_xxxxxxxx)
PAYSTACK_PLAN_CODE=

# Pro monthly price in kobo (NGN). Example: ₦5,000/month → 500000
# Used for admin MRR estimate only
PAYSTACK_PRO_MONTHLY_AMOUNT=3000000

# Prepaid credits granted on one-time top-up payments (optional)
CREDITS_PER_PAYMENT=1000

# Legacy / unused for daily Pro limits — kept for compatibility
CREDITS_PER_SUBSCRIPTION=0


# -----------------------------------------------------------------------------
# AUTH & EMAIL — required for forgot password + email verification
# -----------------------------------------------------------------------------

JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Resend (https://resend.com) — domain must be verified for EMAIL_FROM
RESEND_API_KEY=
EMAIL_FROM=Hello Dreams AI <noreply@yourdomain.com>

# Google OAuth — callback is the BACKEND route, not the frontend
# Google Cloud Console → Authorized redirect URI:
#   Staging:    https://api-staging.hellodreams.ai/auth/google/callback
#   Production: https://api.hellodreams.ai/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback


# -----------------------------------------------------------------------------
# AI — required for core product features
# -----------------------------------------------------------------------------

OPENAI_API_KEY=

# Optional fallbacks / tuning
HUGGINGFACE_API_KEY=
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
AI_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# FX rate for admin cost analytics (NGN per 1 USD)
NGN_TO_USD_RATE=1500


# -----------------------------------------------------------------------------
# FILE STORAGE — required for CV upload, headshots, etc.
# -----------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Prefer service role on the server (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ORIGINAL_HEADSHOT_BUCKET=headshot-originals


# -----------------------------------------------------------------------------
# CREDITS — defaults match product spec (override only if intentional)
# -----------------------------------------------------------------------------

# 1 credit = 800 tokens
TOKENS_PER_CREDIT=800
FREE_DAILY_CREDITS=5
PRO_DAILY_CREDITS=100
MIN_CREDITS_PER_OP=1
HEADSHOT_CREDIT_COST=5
VOICE_CREDIT_COST=2
CV_UPLOAD_CREDIT_COST=1


# -----------------------------------------------------------------------------
# JOB BOARD — optional (Remotive works without keys; others need API keys)
# -----------------------------------------------------------------------------

SERPAPI_API_KEY=
CAREERJET_API_KEY=
JSEARCH_RAPIDAPI_KEY=


# -----------------------------------------------------------------------------
# ALTERNATIVE DB CONFIG — only if DATABASE_URL is not set
# -----------------------------------------------------------------------------

# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=hello_dreams_ai


# =============================================================================
# STAGING TEMPLATE (copy block, replace placeholders)
# =============================================================================
#
# NODE_ENV=production
# CORS_ORIGIN=https://staging.hellodreams.ai
# FRONTEND_URL=https://staging.hellodreams.ai
# GOOGLE_CALLBACK_URL=https://api-staging.hellodreams.ai/auth/google/callback
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_PLAN_CODE=PLN_staging_...
#
# Paystack webhook: https://api-staging.hellodreams.ai/payments/webhook


# =============================================================================
# PRODUCTION TEMPLATE (copy block, replace placeholders)
# =============================================================================
#
# NODE_ENV=production
# CORS_ORIGIN=https://app.hellodreams.ai
# FRONTEND_URL=https://app.hellodreams.ai
# GOOGLE_CALLBACK_URL=https://api.hellodreams.ai/auth/google/callback
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...
# PAYSTACK_PLAN_CODE=PLN_live_...
#
# Paystack webhook: https://api.hellodreams.ai/payments/webhook


# =============================================================================
# POST-DEPLOY CHECKLIST
# =============================================================================
#
# [ ] npm run migration:run (or migration:run:prod on host)
# [ ] Backend health: GET https://<API_HOST>/api-docs
# [ ] Frontend VITE_API_BASE_URL points at API host
# [ ] FRONTEND_URL matches actual frontend URL
# [ ] CORS_ORIGIN includes frontend URL
# [ ] Paystack webhook saved and test event delivered
# [ ] Test flow: Sign up → Subscribe → Paystack → /payments/callback → Pro active
# [ ] Test flow: Forgot password email arrives (Resend)
# [ ] Test flow: Google sign-in redirects to /auth/callback with tokens
